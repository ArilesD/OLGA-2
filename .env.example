# Copiez ce fichier vers ".env" pour surcharger les valeurs par défaut
# du docker-compose. Tous les champs sont facultatifs.
#
# ⚠️ Ce fichier ne contient AUCUN secret. Les secrets (notamment la clé de
# service Firebase) ne doivent jamais être versionnés ni écrits ici.

# Mot de passe MySQL du backend (défaut : rootpassword)
MYSQL_ROOT_PASSWORD=rootpassword

# Nom de la base MySQL (défaut : olga)
MYSQL_DATABASE=olga

# Port exposé de l'Orchestrator sur l'hôte (défaut : 9092)
ORCHESTRATOR_PORT=9092

# Image Docker du backend tirée depuis le registre GHCR (GitHub Container
# Registry). Le backend est distribué UNIQUEMENT sous forme d'image : il n'y a
# aucun code source dans ce repository. Adaptez organisation/tag si vous
# publiez l'image dans un autre compte.
BACKEND_IMAGE=ghcr.io/nexus-ai-innovation-lab/olga-backend:1.0.0
